{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "ask"
  },
  "plugin": [
    [
      "opencode-calibrated-access",
      {
        // ── Provider 1: System One (Jev / Kev / SemIf / Von etc.) ──────────
        // Default provider. Speaks the /v1/systemone protocol used by
        // TypeSafe, OpenRouter, Kev, SemIf, NanoJev, Von, and others.
        // Backward-compat: "typesafeApiKey" and "typesafeModel" also work
        // and map to systemOneApiKey / systemOneModel.

        "provider": "typesafe",                                    // "typesafe" (default) or "openai-compatible"
        "systemOneApiKey": "apikey_...or-sk-or-...or-local-key",   // also reads TYPESAFE_API_KEY env
        "systemOneModel": "jev-latest",                            // jev-latest, jev-1.14, typesafe/jev-1.14
        "systemOneBaseUrl": "https://api.typesafe.ai/v1",           // see notes below

        // OpenRouter users: do NOT use this provider — set systemOneBaseUrl to
        // https://openrouter.ai/api/v1 with your sk-or- key above instead.
        // ── Provider 2: OpenAI-compatible chat fallback ──────────────
        // For general LLMs (gpt-4o-mini, etc.) when no System One model
        // is available. NOT a Jev clone — uses chat completions, not the
        // System One protocol, so scores are less calibrated.
        //
        // "provider": "openai-compatible",
        // "openaiApiKey": "sk-...",       // also reads OPENAI_API_KEY env
        // "openaiModel": "gpt-4o-mini",
        // "openaiBaseUrl": "https://api.openai.com/v1",

        // ── Common options ───────────────────────────────────────────
        "mode": "enforce",                 // "enforce" (default) denies on signals; "shadow" logs only, never blocks

        // Per-signal thresholds (0–1, ask <= block). Omitted signals/fields
        // fall back to the defaults. `user_requested` has no thresholds.
        // Defaults: destructive 0.85/0.6, secret_exposure 0.7/0.5,
        // exfiltration 0.7/0.5, prompt_injection 0.7/0.5,
        // scope_creep 0.8/0.6, severity 0.85/0.6.
        //
        // "signalThresholds": {
        //   "destructive": { "block": 0.9, "ask": 0.7 },
        //   "secret_exposure": { "ask": 0.4 }
        // },

        "sessionApprovals": true,
        "contextMessageCount": 3,
        "diagnosticsPath": "/home/you/.opencode/calibrated-access.jsonl"
      }
    ]
  ]

  // ── System One base URLs by provider ───────────────────────────────
  //
  // TypeSafe native:  https://api.typesafe.ai/v1              (default)
  // OpenRouter Jev:   https://openrouter.ai/api/v1            model: typesafe/jev-1.14
  // Local Kev:        http://localhost:8000/v1                model: kev
  // Local SemIf:      http://localhost:5000/v1                model: semif
  // Local NanoJev:    http://localhost:8080/v1                model: nanojev
  // Local Von:        http://localhost:3000/v1                model: von
  //
  // All append /systemone automatically. The same protocol is used
  // by TypeSafe, OpenRouter, Kev, SemIf, NanoJev, Von, Laya, and
  // any other System One-compatible decision model.
}